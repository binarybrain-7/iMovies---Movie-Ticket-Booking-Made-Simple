PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/imovies
JWT_SECRET=super_secret_imovies_jwt_token_key_change_in_production_987654321
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000/api/v1

# Payment Configuration (Razorpay)
# Mode: "sandbox" (simulation for development/testing) or "razorpay" (live/test credentials)
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email / SMTP Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="IMovies" <no-reply@imovies.app>

# Admin initial setup (used by npm run create-admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@imovies.com
ADMIN_PASSWORD=Admin@123456
